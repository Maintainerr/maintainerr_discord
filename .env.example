# Secrets are injected at runtime. Never commit a filled-in .env.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
MAINTAINERR_DISCORD_DB=/data/bot.sqlite
LOG_LEVEL=debug

# All optional behavior ships disabled.
FEATURE_SMART_DECODER=false
FEATURE_SCREENSHOTS=false
FEATURE_SUPPORT=false
FEATURE_REPORTS=false
FEATURE_TRIAGE=false

# Reports require all three IDs.
DISCORD_FORUM_CHANNEL_ID=
DISCORD_LAUNCHER_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
# Comma-separated channels or forums the bot works in. Empty means DMs only.
DISCORD_SUPPORT_CHANNEL_IDS=

# Configure all three App credentials together. Use a scratch repo for testing.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PEM private key; literal \n sequences are expanded. Secret.
GITHUB_PRIVATE_KEY=
# No default. Point this at a scratch repository until live acceptance is done.
GITHUB_REPOSITORY=

# Empty endpoint means doc links only. Use a free-tier or self-hosted provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION=false
LLM_REQUESTS_PER_MINUTE=1
LLM_DAILY_LIMIT=100

DOCS_REPOSITORY=Maintainerr/Maintainerr_docs
DOCS_REF=main
DOCS_ORIGIN=https://docs.maintainerr.info
ATTACHMENT_MAX_BYTES=1048576
