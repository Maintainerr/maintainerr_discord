# Bot token from https://discord.com/developers/applications
#   -> your application -> Bot -> Reset Token.
# Treat this like a password: anyone holding it controls the bot. Never commit
# the filled-in .env, which .gitignore already excludes.
DISCORD_TOKEN=

# Optional. Register the slash command in a single guild instead of globally.
# Guild commands appear immediately, global ones can take up to an hour to
# propagate, so this is mainly useful while developing.
# To get the ID: enable Developer Mode in Discord, then right-click the server
# and choose Copy Server ID.
DISCORD_GUILD_ID=
